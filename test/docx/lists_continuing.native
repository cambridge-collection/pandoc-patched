            [ Para [ Str "Foo" ] ]
        ]
      , [ Div
            ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
            [ Para [ Str "Bar" ] ]
        ]
      , [ Div
            ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
            [ Para [ Str "Baz" ] ]
        ]
      ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
      [ Para [ Str "Interruption." ] ]
  , OrderedList
      ( 4 , Decimal , Period )
      [ [ Div
            ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
            [ Para [ Str "Bop" ] ]
        ]
      ]
  ]
