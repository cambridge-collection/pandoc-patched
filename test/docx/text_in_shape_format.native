Pandoc
  Meta { unMeta = fromList [] }
  [ Div
      ( "" , [] , [ ( "style" , "text-align: center;" ) ] )
      [ Para
          [ Str "Last"
          , Space
          , Str "update:"
          , Space
          , Str "May"
          , Space
          , Str "1,"
          , Space
          , Str "2017"
          ]
      ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: center;" ) ] )
      [ Para
          [ Str "U"
          , Str "sing"
          , Space
          , Str "Microsoft"
          , Space
          , Str "Word"
          , Space
          , Str "2007/2010"
          , LineBreak
          , Str "for"
          , Space
          , Str "Writing"
          , Space
          , Str "Technical"
          , Space
          , Str "Documents"
          ]
      ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: center;" ) ] )
      [ Para [ Str "Valter" , Space , Str "Kiisk" ] ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: center;" ) ] )
      [ Para
          [ Str "Institute"
          , Space
          , Str "of"
          , Space
          , Str "Physics,"
          , Space
          , Str "University"
          , Space
          , Str "of"
          , Space
          , Str "Tartu"
          ]
      ]
  , Para []
  ]
