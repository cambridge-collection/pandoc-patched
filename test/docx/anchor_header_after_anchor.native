Pandoc
  Meta { unMeta = fromList [] }
  [ Para
      [ Link
          ( "" , [] , [] )
          [ Str "A"
          , Space
          , Str "link"
          , Space
          , Str "to"
          , Space
          , Str "the"
          , Space
          , Str "bookmark"
          ]
          ( "#referenced-title" , "" )
      ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
      [ Para [ Strong [ Str "Accomplices:" ] ] ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
      [ Para
          [ Str "There"
          , Space
          , Str "are"
          , Space
          , Str "bookmarks"
          , Space
          , Str "around"
          , Space
          , Str "here."
          ]
      ]
  , Div
      ( "" , [] , [ ( "style" , "text-align: justify;" ) ] )
      [ Para [] ]
  , Header
      1
      ( "referenced-title" , [] , [] )
      [ Str "Referenced" , Space , Str "title" ]
  , Para [ Str "Content" ]
  ]
